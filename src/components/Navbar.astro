---
const base = "/biblioschool/";
---

<nav class="navbar">
  <div class="nav-contenido">

    <a href={`${base}`} class="logo">
      <span class="logo-icon">B</span>
      <span>BiblioSchool</span>
    </a>

    <div class="nav-links">

      <a href={`${base}`} class="nav-link">
        Inicio
      </a>

      <a href={`${base}catalogo/`} class="nav-link">
        Catálogo
      </a>

      <a
        href={`${base}login/`}
        class="nav-link"
        id="nav-login"
      >
        Iniciar sesión
      </a>

      <a
        href={`${base}registro/`}
        class="nav-link registro"
        id="nav-registro"
      >
        Registrarse
      </a>

      <span
        id="nav-usuario"
        class="nav-usuario"
        style="display:none;"
      ></span>

      <a
        href={`${base}cuenta/`}
        id="nav-cuenta"
        class="nav-link"
        style="display:none;"
      >
        Mi cuenta
      </a>

      <button
        id="nav-logout"
        class="nav-logout"
        style="display:none;"
      >
        Cerrar sesión
      </button>

    </div>
  </div>
</nav>

<script>
  import { supabase } from "../lib/supabase.js";

  const base = "/biblioschool/";

  const login = document.querySelector("#nav-login");
  const registro = document.querySelector("#nav-registro");
  const usuario = document.querySelector("#nav-usuario");
  const cuenta = document.querySelector("#nav-cuenta");
  const logout = document.querySelector("#nav-logout");

  function mostrarUsuario(session) {
    if (session?.user) {
      const datos = session.user.user_metadata || {};

      const nombre =
        datos.nombre_usuario ||
        datos.nombre_completo ||
        session.user.email?.split("@")[0] ||
        "Usuario";

      login.style.display = "none";
      registro.style.display = "none";

      usuario.textContent = nombre;
      usuario.style.display = "inline-flex";

      cuenta.style.display = "inline-flex";
      logout.style.display = "inline-flex";
    } else {
      login.style.display = "inline-flex";
      registro.style.display = "inline-flex";

      usuario.style.display = "none";
      cuenta.style.display = "none";
      logout.style.display = "none";
    }
  }

  async function iniciar() {
    const { data } = await supabase.auth.getSession();
    mostrarUsuario(data.session);
  }

  logout?.addEventListener("click", async () => {
    await supabase.auth.signOut();
    window.location.href = `${base}login/`;
  });

  supabase.auth.onAuthStateChange((_event, session) => {
    mostrarUsuario(session);
  });

  iniciar();
</script>

<style>
  .navbar {
    width: 100%;
    background: #fffdf9;
    border-bottom: 1px solid #e8dfd5;
    position: relative;
    z-index: 20;
  }

  .nav-contenido {
    max-width: 1200px;
    margin: 0 auto;
    min-height: 76px;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #302b26;
    font-weight: 800;
    font-size: 1.15rem;
  }

  .logo-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: #302b26;
    color: white;
    font-weight: 900;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 8px;
  }

  .nav-link,
  .nav-logout {
    text-decoration: none;
    border: 0;
    background: transparent;
    color: #5f554c;
    padding: 9px 12px;
    border-radius: 9px;
    font-size: 0.88rem;
    cursor: pointer;
  }

  .nav-link:hover,
  .nav-logout:hover {
    background: #eee7df;
    color: #302b26;
  }

  .nav-link.registro {
    background: #302b26;
    color: white;
  }

  .nav-link.registro:hover {
    background: #574b40;
    color: white;
  }

  .nav-usuario {
    color: #302b26;
    font-weight: 800;
    padding: 9px 8px;
    font-size: 0.88rem;
  }

  @media (max-width: 700px) {
    .nav-contenido {
      flex-direction: column;
      padding: 18px;
    }

    .nav-links {
      justify-content: center;
    }
  }
</style>