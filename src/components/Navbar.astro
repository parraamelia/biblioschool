
---
const base = import.meta.env.BASE_URL;
const inicio = base;
const catalogo = `${base}catalogo`;
const login = `${base}login`;
const registro = `${base}registro`;
---

<header class="navbar">
  <div class="contenedor">
    <a href={inicio} class="logo">
      Biblio<span>School</span>
    </a>

    <nav>
      <a href={inicio} class="enlace">Inicio</a>
      <a href={catalogo} class="enlace">Catálogo</a>
      <a href={login} class="enlace">Iniciar sesión</a>
      <a href={registro} class="registro">Registrarse</a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    width: 100%;
    background: #f6f3ec;
    border-bottom: 1px solid #dcd8cd;
    position: relative;
    z-index: 10;
  }

  .contenedor {
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: 20px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .logo {
    color: #293e33;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 25px;
    font-weight: 400;
    letter-spacing: -0.5px;
  }

  .logo span {
    font-style: italic;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .enlace {
    position: relative;
    color: #4f554f;
    font-size: 13px;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .enlace::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -7px;
    width: 0;
    height: 1px;
    background: #293e33;
    transition: width 0.2s ease;
  }

  .enlace:hover {
    color: #293e33;
  }

  .enlace:hover::after {
    width: 100%;
  }

  .registro {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 17px;
    border: 1px solid #293e33;
    color: #293e33;
    font-size: 12px;
    font-weight: 600;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .registro:hover {
    background: #293e33;
    color: #ffffff;
  }

  @media (max-width: 700px) {
    .contenedor {
      padding: 18px 25px;
      flex-direction: column;
      align-items: center;
    }

    nav {
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
      gap: 18px 22px;
    }
  }

  @media (max-width: 430px) {
    .contenedor {
      padding: 17px 18px;
    }

    .logo {
      font-size: 23px;
    }

    nav {
      gap: 14px 18px;
    }

    .enlace {
      font-size: 12px;
    }

    .registro {
      min-height: 36px;
      padding: 0 13px;
    }
  }
</style>
