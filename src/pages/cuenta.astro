---
import Layout from "../layouts/Layout.astro";
import { libros } from "../data/libros.js";

const base = "/biblioschool/";
---

<Layout
  titulo="Mi cuenta | BiblioSchool"
  descripcion="Espacio personal de BiblioSchool."
>
  <main class="cuenta">
    <section class="bienvenida">
      <div>
        <p class="etiqueta">BIBLIOSCHOOL</p>
        <h1>Mi cuenta</h1>
        <p id="saludo">
          Bienvenido a tu espacio personal.
        </p>
        <p id="correo-usuario" class="correo"></p>
      </div>

      <button id="cerrar-sesion" class="boton-salir">
        Cerrar sesión
      </button>
    </section>

    <section class="biblioteca">
      <div class="titulo-seccion">
        <div>
          <p class="etiqueta">TU BIBLIOTECA</p>
          <h2>Libros disponibles</h2>
        </div>

        <span class="cantidad">{libros.length} títulos</span>
      </div>

      <div class="libros-grid">
        {libros.map((libro) => (
          <article class="libro-card">
            <a href={`${base}libro/${libro.id}/`} class="portada-link">
              <div class="portada">
                <img
                  src={libro.portada}
                  alt={`Portada de ${libro.titulo}`}
                  loading="lazy"
                />
              </div>
            </a>

            <div class="informacion">
              <span class="categoria">{libro.categoria}</span>

              <h3>{libro.titulo}</h3>

              <p>{libro.autor}</p>

              <a
                href={`${base}libro/${libro.id}/`}
                class="boton-libro"
              >
                Ver libro
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>

<script>
  import { supabase } from "../lib/supabase.js";

  const base = "/biblioschool/";

  const saludo = document.querySelector("#saludo");
  const correoUsuario = document.querySelector("#correo-usuario");
  const cerrarSesion = document.querySelector("#cerrar-sesion");

  async function cargarCuenta() {
    const { data, error } = await supabase.auth.getSession();

    if (error || !data.session) {
      window.location.href = `${base}login/`;
      return;
    }

    const usuario = data.session.user;

    const nombreUsuario =
      usuario.user_metadata?.nombre_usuario ||
      usuario.user_metadata?.nombre_completo ||
      usuario.email?.split("@")[0] ||
      "Usuario";

    saludo.textContent = `Bienvenido, ${nombreUsuario}.`;
    correoUsuario.textContent = usuario.email || "";
  }

  cerrarSesion?.addEventListener("click", async () => {
    cerrarSesion.disabled = true;
    cerrarSesion.textContent = "Cerrando sesión...";

    await supabase.auth.signOut();

    window.location.href = `${base}login/`;
  });

  cargarCuenta();
</script>

<style>
  .cuenta {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 24px 90px;
  }

  .bienvenida {
    background: #302b26;
    color: white;
    border-radius: 26px;
    padding: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 55px;
  }

  .etiqueta {
    color: #c6a77a;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 3px;
    margin: 0 0 10px;
  }

  .bienvenida h1 {
    margin: 0;
    font-size: clamp(2.3rem, 5vw, 4rem);
  }

  .bienvenida p {
    margin-top: 12px;
  }

  .correo {
    color: #cfc6bd;
    font-size: 0.9rem;
  }

  .boton-salir {
    border: 1px solid #cfc6bd;
    background: transparent;
    color: white;
    padding: 12px 20px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 700;
  }

  .boton-salir:hover {
    background: white;
    color: #302b26;
  }

  .titulo-seccion {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 28px;
  }

  .titulo-seccion h2 {
    color: #29241f;
    margin: 0;
    font-size: 2rem;
  }

  .cantidad {
    background: #eee7df;
    color: #665d55;
    padding: 9px 15px;
    border-radius: 20px;
    font-size: 0.85rem;
  }

  .libros-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .libro-card {
    background: #fffdf9;
    border: 1px solid #e5ddd3;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(50, 40, 30, 0.06);
    transition: 0.25s;
  }

  .libro-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 35px rgba(50, 40, 30, 0.12);
  }

  .portada-link {
    display: block;
  }

  .portada {
    height: 300px;
    background: #eee7df;
    overflow: hidden;
  }

  .portada img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .informacion {
    padding: 18px;
  }

  .categoria {
    color: #9a7951;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .informacion h3 {
    color: #29241f;
    font-size: 1.05rem;
    line-height: 1.3;
    margin: 8px 0 5px;
  }

  .informacion p {
    color: #71675e;
    font-size: 0.88rem;
    margin: 0 0 16px;
  }

  .boton-libro {
    display: block;
    text-align: center;
    text-decoration: none;
    background: #302b26;
    color: white;
    padding: 10px;
    border-radius: 9px;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .boton-libro:hover {
    background: #574b40;
  }

  @media (max-width: 1000px) {
    .libros-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 700px) {
    .bienvenida {
      flex-direction: column;
      align-items: flex-start;
    }

    .libros-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .portada {
      height: 260px;
    }
  }

  @media (max-width: 480px) {
    .libros-grid {
      grid-template-columns: 1fr;
    }
  }
</style>