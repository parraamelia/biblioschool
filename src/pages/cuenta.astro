---
import Layout from "../layouts/Layout.astro";
---

<Layout titulo="Mi cuenta | BiblioSchool">

  <main class="cuenta">

    <section class="encabezado">

      <div>

        <p class="etiqueta">
          BIBLIOSCHOOL / MI CUENTA
        </p>

        <h1>
          Hola,
          <span id="nombre-usuario">lector.</span>
        </h1>

        <p class="descripcion">
          Este es tu espacio personal dentro de BiblioSchool.
          Desde aquí puedes consultar nuestra colección y
          comenzar a leer.
        </p>

      </div>

      <div class="numero">

        <span>01</span>

        <small>
          ESPACIO<br />
          PERSONAL
        </small>

      </div>

    </section>


    <section class="datos-usuario">

      <div>
        <p>USUARIO</p>
        <strong id="usuario-correo">
          Cargando...
        </strong>
      </div>

      <div>
        <p>ESTADO</p>
        <strong>Cuenta activa</strong>
      </div>

    </section>


    <section class="contenido">

      <div class="barra">

        <div>

          <p class="numero-seccion">
            01 / COLECCIÓN
          </p>

          <h2>
            Libros disponibles
          </h2>

        </div>

        <p class="cantidad">
          06 títulos
        </p>

      </div>


      <section class="libros">

        <article class="libro">

          <div class="portada">
            <span>01</span>
            <strong>
              Cien años<br />
              de soledad
            </strong>
            <small>
              Gabriel García Márquez
            </small>
          </div>

          <div class="info">

            <p class="numero-libro">
              01 / LITERATURA
            </p>

            <h3>
              Cien años de soledad
            </h3>

            <p>
              Una de las obras fundamentales de la literatura
              latinoamericana.
            </p>

            <a href="/libro/1">
              Ver libro →
            </a>

          </div>

        </article>


        <article class="libro">

          <div class="portada">
            <span>02</span>
            <strong>
              Don Quijote<br />
              de la Mancha
            </strong>
            <small>
              Miguel de Cervantes
            </small>
          </div>

          <div class="info">

            <p class="numero-libro">
              02 / CLÁSICOS
            </p>

            <h3>
              Don Quijote de la Mancha
            </h3>

            <p>
              Una de las obras fundamentales de la literatura
              española.
            </p>

            <a href="/libro/2">
              Ver libro →
            </a>

          </div>

        </article>


        <article class="libro">

          <div class="portada">
            <span>03</span>
            <strong>
              La<br />
              Odisea
            </strong>
            <small>
              Homero
            </small>
          </div>

          <div class="info">

            <p class="numero-libro">
              03 / LITERATURA CLÁSICA
            </p>

            <h3>
              La Odisea
            </h3>

            <p>
              El viaje de Odiseo y su largo regreso a Ítaca.
            </p>

            <a href="/libro/3">
              Ver libro →
            </a>

          </div>

        </article>


        <article class="libro">

          <div class="portada">
            <span>04</span>
            <strong>
              El<br />
              principito
            </strong>
            <small>
              Antoine de Saint-Exupéry
            </small>
          </div>

          <div class="info">

            <p class="numero-libro">
              04 / LITERATURA JUVENIL
            </p>

            <h3>
              El principito
            </h3>

            <p>
              Una historia para reflexionar sobre la amistad
              y las relaciones humanas.
            </p>

            <a href="/libro/4">
              Ver libro →
            </a>

          </div>

        </article>


        <article class="libro">

          <div class="portada">
            <span>05</span>
            <strong>
              Don Juan<br />
              Tenorio
            </strong>
            <small>
              José Zorrilla
            </small>
          </div>

          <div class="info">

            <p class="numero-libro">
              05 / TEATRO
            </p>

            <h3>
              Don Juan Tenorio
            </h3>

            <p>
              Una obra teatral del Romanticismo español.
            </p>

            <a href="/libro/5">
              Ver libro →
            </a>

          </div>

        </article>


        <article class="libro">

          <div class="portada">
            <span>06</span>
            <strong>
              La casa<br />
              de los espíritus
            </strong>
            <small>
              Isabel Allende
            </small>
          </div>

          <div class="info">

            <p class="numero-libro">
              06 / LITERATURA
            </p>

            <h3>
              La casa de los espíritus
            </h3>

            <p>
              Una historia familiar relacionada con importantes
              cambios sociales.
            </p>

            <a href="/libro/6">
              Ver libro →
            </a>

          </div>

        </article>

      </section>


      <section class="cerrar">

        <div>

          <p class="numero-seccion">
            CUENTA
          </p>

          <h2>
            ¿Quieres salir de tu cuenta?
          </h2>

        </div>

        <button id="cerrar-sesion">
          Cerrar sesión →
        </button>

      </section>

    </section>

  </main>

</Layout>


<script>

  import { supabase } from "../lib/supabase.js";

  const nombreUsuario =
    document.querySelector("#nombre-usuario");

  const correoUsuario =
    document.querySelector("#usuario-correo");

  const botonCerrar =
    document.querySelector("#cerrar-sesion");


  async function comprobarSesion() {

    const {
      data: { session }
    } = await supabase.auth.getSession();


    if (!session) {

      window.location.href = "/login";

      return;

    }


    const usuario = session.user;


    const nombre =
      usuario.user_metadata?.nombre_completo;


    if (nombre) {

      const primerNombre =
        nombre.trim().split(" ")[0];

      if (nombreUsuario) {
        nombreUsuario.textContent =
          `${primerNombre}.`;
      }

    }


    if (correoUsuario) {

      correoUsuario.textContent =
        usuario.email || "Correo no disponible";

    }

  }


  comprobarSesion();


  botonCerrar?.addEventListener(
    "click",
    async () => {

      botonCerrar.textContent =
        "Cerrando sesión...";


      const { error } =
        await supabase.auth.signOut();


      if (error) {

        console.error(
          "Error al cerrar sesión:",
          error
        );

        botonCerrar.textContent =
          "No se pudo cerrar sesión";

        return;

      }


      window.location.href = "/login";

    }
  );

</script>


<style>

  .cuenta {
    max-width: 1200px;
    margin: 0 auto;
    padding: 70px 40px 100px;
  }


  .encabezado {
    display: grid;
    grid-template-columns: 1fr 180px;
    gap: 60px;

    padding-bottom: 70px;

    border-bottom: 1px solid #dcd8cd;
  }


  .etiqueta {
    margin-bottom: 20px;

    color: #687468;

    font-size: 11px;
    font-weight: 700;

    letter-spacing: 2px;
  }


  .encabezado h1 {
    margin-bottom: 25px;

    color: #293e33;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: clamp(48px, 7vw, 82px);
    font-weight: 400;

    line-height: 0.95;

    letter-spacing: -2px;
  }


  .encabezado h1 span {
    display: block;

    font-style: italic;
  }


  .descripcion {
    max-width: 620px;

    color: #65665f;

    font-size: 16px;

    line-height: 1.8;
  }


  .numero {
    align-self: end;

    display: flex;
    flex-direction: column;

    gap: 8px;

    padding-top: 20px;

    border-top: 1px solid #293e33;
  }


  .numero span {
    color: #293e33;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 42px;
  }


  .numero small {
    color: #687468;

    font-size: 9px;
    font-weight: 700;

    line-height: 1.5;

    letter-spacing: 1.5px;
  }


  .datos-usuario {

    display: grid;

    grid-template-columns: 1fr 1fr;

    border-bottom: 1px solid #dcd8cd;
  }


  .datos-usuario > div {

    padding: 25px 0;

  }


  .datos-usuario > div + div {

    padding-left: 40px;

    border-left: 1px solid #dcd8cd;

  }


  .datos-usuario p {

    margin-bottom: 7px;

    color: #8b978b;

    font-size: 9px;
    font-weight: 700;

    letter-spacing: 1.5px;

  }


  .datos-usuario strong {

    color: #293e33;

    font-size: 14px;

    font-weight: 500;

  }


  .contenido {

    padding-top: 70px;
  }


  .barra {

    display: flex;

    align-items: end;

    justify-content: space-between;

    gap: 30px;

    margin-bottom: 45px;
  }


  .numero-seccion {

    margin-bottom: 10px;

    color: #8b978b;

    font-size: 10px;
    font-weight: 700;

    letter-spacing: 1.7px;
  }


  .barra h2 {

    color: #293e33;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 38px;

    font-weight: 400;
  }


  .cantidad {

    color: #777870;

    font-size: 12px;
  }


  .libros {

    display: grid;

    grid-template-columns: 1fr 1fr;

    border-top: 1px solid #dcd8cd;
  }


  .libro {

    display: grid;

    grid-template-columns: 150px 1fr;

    gap: 30px;

    padding: 35px 0;

    border-bottom: 1px solid #dcd8cd;
  }


  .libro:nth-child(odd) {

    padding-right: 35px;

    border-right: 1px solid #dcd8cd;

  }


  .libro:nth-child(even) {

    padding-left: 35px;

  }


  .portada {

    min-height: 210px;

    padding: 18px;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

    background: #405b49;

    color: #f6f3ec;

  }


  .libro:nth-child(2) .portada {
    background: #5b6659;
  }


  .libro:nth-child(3) .portada {
    background: #6b6657;
  }


  .libro:nth-child(4) .portada {
    background: #65746a;
  }


  .libro:nth-child(5) .portada {
    background: #746b5d;
  }


  .libro:nth-child(6) .portada {
    background: #4f6356;
  }


  .portada span {

    font-size: 9px;

    letter-spacing: 1.5px;

  }


  .portada strong {

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 20px;

    font-weight: 400;

    line-height: 1.1;

  }


  .portada small {

    font-size: 9px;

    line-height: 1.3;

    opacity: 0.8;

  }


  .info {

    display: flex;

    flex-direction: column;

    align-items: flex-start;

    padding-top: 5px;
  }


  .numero-libro {

    margin-bottom: 14px;

    color: #8b978b;

    font-size: 9px;

    font-weight: 700;

    letter-spacing: 1.3px;

  }


  .info h3 {

    margin-bottom: 12px;

    color: #293e33;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 24px;

    font-weight: 400;

    line-height: 1.15;

  }


  .info p:not(.numero-libro) {

    margin-bottom: 25px;

    color: #777870;

    font-size: 13px;

    line-height: 1.6;

  }


  .info a {

    margin-top: auto;

    color: #293e33;

    font-size: 12px;

    font-weight: 700;

  }


  .info a:hover {

    text-decoration: underline;

  }


  .cerrar {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;

    margin-top: 80px;

    padding: 35px 0;

    border-top: 1px solid #293e33;

    border-bottom: 1px solid #dcd8cd;

  }


  .cerrar h2 {

    color: #293e33;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 25px;

    font-weight: 400;

  }


  .cerrar button {

    min-height: 42px;

    padding: 0 20px;

    border: 1px solid #293e33;

    background: transparent;

    color: #293e33;

    font-size: 12px;

    font-weight: 600;

    transition:
      background-color 0.2s ease,
      color 0.2s ease;

  }


  .cerrar button:hover {

    background: #293e33;

    color: #ffffff;

  }


  @media (max-width: 950px) {

    .libro {

      grid-template-columns: 125px 1fr;

      gap: 22px;

    }

    .portada {

      min-height: 190px;

    }

  }


  @media (max-width: 750px) {

    .cuenta {

      padding: 50px 25px 80px;

    }

    .encabezado {

      grid-template-columns: 1fr;

      gap: 40px;

    }

    .numero {

      max-width: 180px;

    }

    .libros {

      grid-template-columns: 1fr;

    }

    .libro:nth-child(odd) {

      padding-right: 0;

      border-right: 0;

    }

    .libro:nth-child(even) {

      padding-left: 0;

    }

  }


  @media (max-width: 500px) {

    .cuenta {

      padding: 40px 18px 70px;

    }

    .encabezado h1 {

      font-size: 50px;

    }

    .datos-usuario {

      grid-template-columns: 1fr;

    }

    .datos-usuario > div + div {

      padding-left: 0;

      border-left: 0;

      border-top: 1px solid #dcd8cd;

    }

    .barra {

      align-items: flex-start;

      flex-direction: column;

      gap: 8px;

    }

    .libro {

      grid-template-columns: 105px 1fr;

      gap: 18px;

    }

    .portada {

      min-height: 165px;

      padding: 13px;

    }

    .portada strong {

      font-size: 16px;

    }

    .info h3 {

      font-size: 20px;

    }

    .cerrar {

      align-items: flex-start;

      flex-direction: column;

    }

  }

</style>