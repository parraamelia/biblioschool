---
import Layout from "../../layouts/Layout.astro";
import { libros } from "../../data/libros.js";

export function getStaticPaths() {
  return libros.map((libro) => ({
    params: {
      id: libro.id
    },
    props: {
      libro
    }
  }));
}

const { libro } = Astro.props;

if (!libro) {
  return Astro.redirect("/catalogo");
}
---

<Layout titulo={`${libro.titulo} | BiblioSchool`}>

  <main class="lectura">

    <section class="cabecera">

      <div class="cabecera-texto">

        <a href={`/libro/${libro.id}`} class="volver">
          ← Volver al libro
        </a>

        <p class="etiqueta">
          BIBLIOSCHOOL / LECTURA
        </p>

        <h1>
          {libro.titulo}
        </h1>

        <p class="autor">
          {libro.autor}
        </p>

        <p class="descripcion">
          {libro.descripcion}
        </p>

      </div>

      <div class="ficha">

        <span>FICHA DE LECTURA</span>

        <strong>
          {libro.categoria}
        </strong>

        <small>
          Publicación: {libro.anio}
        </small>

      </div>

    </section>


    <section class="contenido">

      <aside class="indice">

        <p>CONTENIDO</p>

        <nav>

          {
            libro.contenido.map((seccion) => (
              <a href={`#seccion-${seccion.numero}`}>
                <span>{seccion.numero}</span>
                {seccion.titulo}
              </a>
            ))
          }

        </nav>

      </aside>


      <article class="texto">

        <div class="inicio-lectura">

          <p class="numero">
            LECTURA
          </p>

          <h2>
            Conoce la obra
          </h2>

          <p>
            En esta sección encontrarás información organizada
            para comprender mejor la obra, sus temas principales
            y sus ideas más importantes.
          </p>

        </div>


        {
          libro.contenido.map((seccion) => (
            <section
              id={`seccion-${seccion.numero}`}
              class="seccion"
            >

              <div class="numero-seccion">
                {seccion.numero}
              </div>

              <div>

                <h2>
                  {seccion.titulo}
                </h2>

                <div class="parrafos">

                  {
                    seccion.texto
                      .trim()
                      .split("\n\n")
                      .map((parrafo) => (
                        <p>
                          {parrafo.trim()}
                        </p>
                      ))
                  }

                </div>

              </div>

            </section>
          ))
        }


        <section class="final">

          <p class="numero">
            BIBLIOSCHOOL
          </p>

          <h2>
            Terminaste esta sección.
          </h2>

          <p>
            Puedes volver a la información del libro o regresar
            a tu biblioteca para continuar explorando la colección.
          </p>

          <div class="acciones">

            <a href={`/libro/${libro.id}`}>
              ← Información del libro
            </a>

            <a href="/cuenta">
              Mi biblioteca →
            </a>

          </div>

        </section>

      </article>

    </section>

  </main>

</Layout>


<script>
  import { supabase } from "../../lib/supabase.js";

  async function comprobarSesion() {

    const {
      data: { session }
    } = await supabase.auth.getSession();

    if (!session) {
      window.location.href = "/login";
    }

  }

  comprobarSesion();
</script>


<style>

  .lectura {
    max-width: 1200px;
    margin: 0 auto;
    padding: 70px 40px 100px;
  }

  .cabecera {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 80px;
    padding-bottom: 70px;
    border-bottom: 1px solid #dcd8cd;
  }

  .volver {
    display: inline-block;
    margin-bottom: 45px;
    color: #65665f;
    font-size: 13px;
    transition: color 0.2s ease;
  }

  .volver:hover {
    color: #293e33;
  }

  .etiqueta {
    margin-bottom: 18px;
    color: #687468;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .cabecera h1 {
    max-width: 800px;
    margin-bottom: 12px;
    color: #293e33;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(42px, 6vw, 76px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -2px;
  }

  .autor {
    margin-bottom: 25px;
    color: #687468;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 21px;
  }

  .descripcion {
    max-width: 650px;
    color: #65665f;
    font-size: 16px;
    line-height: 1.8;
  }

  .ficha {
    align-self: end;
    padding: 25px 0;
    border-top: 1px solid #293e33;
    border-bottom: 1px solid #dcd8cd;
  }

  .ficha span {
    display: block;
    margin-bottom: 18px;
    color: #687468;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.7px;
  }

  .ficha strong {
    display: block;
    margin-bottom: 8px;
    color: #293e33;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 21px;
    font-weight: 400;
  }

  .ficha small {
    color: #777870;
    font-size: 12px;
  }

  .contenido {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 90px;
    padding-top: 70px;
  }

  .indice {
    position: sticky;
    top: 30px;
    align-self: start;
  }

  .indice > p {
    margin-bottom: 20px;
    color: #687468;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.7px;
  }

  .indice nav {
    display: flex;
    flex-direction: column;
  }

  .indice a {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 8px;
    padding: 13px 0;
    border-bottom: 1px solid #e2dfd5;
    color: #65665f;
    font-size: 12px;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .indice a:hover {
    color: #293e33;
  }

  .indice a span {
    color: #9a9a91;
  }

  .texto {
    max-width: 760px;
  }

  .inicio-lectura {
    padding-bottom: 65px;
    border-bottom: 1px solid #dcd8cd;
  }

  .numero {
    margin-bottom: 14px;
    color: #8b978b;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .inicio-lectura h2 {
    margin-bottom: 20px;
    color: #293e33;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 38px;
    font-weight: 400;
    line-height: 1.1;
  }

  .inicio-lectura p:last-child {
    max-width: 620px;
    color: #65665f;
    font-size: 16px;
    line-height: 1.9;
  }

  .seccion {
    display: grid;
    grid-template-columns: 65px 1fr;
    gap: 25px;
    padding: 65px 0;
    border-bottom: 1px solid #dcd8cd;
  }

  .numero-seccion {
    color: #8b978b;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .seccion h2 {
    margin-bottom: 25px;
    color: #293e33;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 34px;
    font-weight: 400;
    line-height: 1.15;
  }

  .parrafos {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .parrafos p {
    color: #4e514c;
    font-size: 16px;
    line-height: 1.9;
  }

  .final {
    padding: 70px 0 20px;
  }

  .final h2 {
    margin-bottom: 18px;
    color: #293e33;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 36px;
    font-weight: 400;
  }

  .final > p:nth-child(3) {
    max-width: 600px;
    margin-bottom: 30px;
    color: #65665f;
    line-height: 1.8;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
  }

  .acciones a {
    color: #293e33;
    font-size: 13px;
    font-weight: 600;
  }

  .acciones a:hover {
    text-decoration: underline;
  }


  @media (max-width: 850px) {

    .lectura {
      padding: 50px 25px 80px;
    }

    .cabecera {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ficha {
      max-width: 300px;
    }

    .contenido {
      grid-template-columns: 1fr;
      gap: 45px;
      padding-top: 50px;
    }

    .indice {
      position: static;
    }

    .indice nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 25px;
    }

  }


  @media (max-width: 550px) {

    .lectura {
      padding: 40px 18px 70px;
    }

    .cabecera h1 {
      font-size: 44px;
      letter-spacing: -1px;
    }

    .autor {
      font-size: 18px;
    }

    .descripcion {
      font-size: 14px;
    }

    .indice nav {
      grid-template-columns: 1fr;
    }

    .seccion {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 50px 0;
    }

    .seccion h2 {
      font-size: 29px;
    }

    .parrafos p {
      font-size: 15px;
      line-height: 1.8;
    }

  }

</style>