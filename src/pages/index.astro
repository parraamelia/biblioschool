---
import Layout from "../layouts/Layout.astro";
import { supabase } from "../lib/supabase.js";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const loginUrl = `${base}login/`;
const cuentaUrl = `${base}cuenta/`;
const catalogoUrl = `${base}catalogo/`;
const resenasUrl = `${base}resenas/`;
---

<Layout
  titulo="BiblioSchool | Biblioteca Escolar"
  descripcion="Biblioteca virtual escolar para descubrir, consultar y compartir libros."
>

  <main>

    <section class="hero">
      <div class="hero-text">

        <span class="hero-label">
          BIBLIOTECA ESCOLAR DIGITAL
        </span>

        <h1>
          Un lugar para<br />
          <em>leer, descubrir</em><br />
          y aprender.
        </h1>

        <p>
          Explora libros de diferentes épocas, géneros y autores.
          Encuentra nuevas historias y descubre lecturas que pueden
          acompañarte dentro y fuera del aula.
        </p>

        <div class="hero-buttons">

          <a href={catalogoUrl} class="btn-principal">
            Explorar catálogo →
          </a>

          <a href={loginUrl} class="btn-secundario" id="inicio-login">
            Iniciar sesión
          </a>

          <a
            href={cuentaUrl}
            class="btn-secundario"
            id="inicio-cuenta"
            style="display:none;"
          >
            Mi cuenta
          </a>

        </div>

      </div>
    </section>


    <section class="explorar">

      <div class="section-heading">

        <span>01</span>

        <div>
          <h2>Explora</h2>

          <p>
            Encuentra libros de diferentes géneros, autores y épocas.
          </p>

          <a href={catalogoUrl}>
            Ver catálogo →
          </a>
        </div>

      </div>


      <div class="section-heading">

        <span>02</span>

        <div>
          <h2>Descubre</h2>

          <p>
            Mira los libros mejor valorados por nuestros lectores y
            descubre qué historias están recomendando.
          </p>

          <a href={resenasUrl}>
            Ver mejores reseñas →
          </a>
        </div>

      </div>


      <div class="section-heading">

        <span>03</span>

        <div>

          <h2 id="servicio-cuenta-titulo">
            Tu cuenta
          </h2>

          <p id="servicio-cuenta-texto">
            Guarda tu espacio personal y disfruta de una experiencia
            más organizada dentro de BiblioSchool.
          </p>

          <a
            href={loginUrl}
            id="servicio-cuenta-link"
          >
            Iniciar sesión →
          </a>

        </div>

      </div>

    </section>


    <section class="descubre">

      <div class="descubre-inner">

        <span>03</span>

        <h2>
          ¿No sabes qué<br />
          <em>leer después?</em>
        </h2>

        <p>
          Las reseñas de otros lectores pueden ayudarte a encontrar
          una historia que realmente te interese.
        </p>

        <a href={resenasUrl}>
          Descubrir libros →
        </a>

      </div>

    </section>

  </main>

</Layout>


<script>
  import { supabase } from "../lib/supabase.js";

  const base = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;

  const loginUrl = `${base}login/`;
  const cuentaUrl = `${base}cuenta/`;

  const loginButton =
    document.getElementById("inicio-login");

  const cuentaButton =
    document.getElementById("inicio-cuenta");

  const cuentaTitulo =
    document.getElementById("servicio-cuenta-titulo");

  const cuentaTexto =
    document.getElementById("servicio-cuenta-texto");

  const cuentaLink =
    document.getElementById("servicio-cuenta-link");


  const comprobarSesion = async () => {

    try {

      const { data } =
        await supabase.auth.getSession();

      const session = data?.session;


      if (session) {

        if (loginButton) {
          loginButton.style.display = "none";
        }

        if (cuentaButton) {
          cuentaButton.style.display = "inline-block";
        }

        if (cuentaTitulo) {
          cuentaTitulo.textContent = "Tu cuenta";
        }

        if (cuentaTexto) {
          cuentaTexto.textContent =
            "Ya tienes una cuenta. Entra a tu espacio personal para consultar tus libros.";
        }

        if (cuentaLink) {
          cuentaLink.href = cuentaUrl;
          cuentaLink.textContent = "Ir a mi cuenta →";
        }

      } else {

        if (loginButton) {
          loginButton.style.display = "inline-block";
        }

        if (cuentaButton) {
          cuentaButton.style.display = "none";
        }

        if (cuentaTitulo) {
          cuentaTitulo.textContent = "Tu cuenta";
        }

        if (cuentaTexto) {
          cuentaTexto.textContent =
            "Crea tu cuenta o inicia sesión para disfrutar de tu espacio personal.";
        }

        if (cuentaLink) {
          cuentaLink.href = loginUrl;
          cuentaLink.textContent = "Iniciar sesión →";
        }

      }

    } catch (error) {

      console.log(
        "No se pudo comprobar la sesión:",
        error
      );

    }

  };


  comprobarSesion();


  supabase.auth.onAuthStateChange(
    (_event, session) => {

      if (session) {

        if (loginButton) {
          loginButton.style.display = "none";
        }

        if (cuentaButton) {
          cuentaButton.style.display = "inline-block";
        }

        if (cuentaLink) {
          cuentaLink.href = cuentaUrl;
          cuentaLink.textContent = "Ir a mi cuenta →";
        }

      } else {

        if (loginButton) {
          loginButton.style.display = "inline-block";
        }

        if (cuentaButton) {
          cuentaButton.style.display = "none";
        }

        if (cuentaLink) {
          cuentaLink.href = loginUrl;
          cuentaLink.textContent = "Iniciar sesión →";
        }

      }

    }
  );
</script>


<style>

  .hero {
    min-height: 78vh;
    display: flex;
    align-items: center;
    padding: 80px 9%;
    background: #f7f3ea;
  }

  .hero-text {
    max-width: 850px;
  }

  .hero-label {
    color: #8b7750;
    font-size: .78rem;
    letter-spacing: 2px;
  }

  .hero h1 {
    margin: 25px 0;
    color: #183c32;
    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: .95;
    font-weight: 500;
  }

  .hero h1 em {
    color: #a48751;
    font-family: Georgia, serif;
    font-weight: 400;
  }

  .hero p {
    max-width: 620px;
    color: #666;
    line-height: 1.8;
    font-size: 1.05rem;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }

  .btn-principal,
  .btn-secundario {
    padding: 14px 23px;
    text-decoration: none;
    transition: .25s;
  }

  .btn-principal {
    background: #183c32;
    color: white;
  }

  .btn-principal:hover {
    background: #285849;
  }

  .btn-secundario {
    border: 1px solid #183c32;
    color: #183c32;
  }

  .btn-secundario:hover {
    background: #183c32;
    color: white;
  }

  .explorar {
    max-width: 1100px;
    margin: auto;
    padding: 100px 25px;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 20px;
    padding: 40px 0;
    border-top: 1px solid #ddd5c8;
  }

  .section-heading > span {
    color: #a48751;
    font-size: .9rem;
  }

  .section-heading h2 {
    margin: 0 0 10px;
    color: #183c32;
    font-size: 2.8rem;
    font-weight: 500;
  }

  .section-heading p {
    max-width: 650px;
    margin: 0 0 18px;
    color: #666;
    line-height: 1.7;
  }

  .section-heading a {
    color: #183c32;
    font-weight: bold;
    text-decoration: none;
  }

  .section-heading a:hover {
    text-decoration: underline;
  }

  .descubre {
    padding: 100px 25px;
    background: #183c32;
    color: white;
  }

  .descubre-inner {
    max-width: 1100px;
    margin: auto;
  }

  .descubre-inner > span {
    color: #d7b878;
  }

  .descubre h2 {
    margin: 25px 0;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1;
    font-weight: 400;
  }

  .descubre h2 em {
    color: #d7b878;
    font-family: Georgia, serif;
  }

  .descubre p {
    max-width: 550px;
    color: rgba(255,255,255,.75);
    line-height: 1.8;
  }

  .descubre a {
    display: inline-block;
    margin-top: 25px;
    padding: 14px 23px;
    background: #d7b878;
    color: #183c32;
    text-decoration: none;
  }

  @media (max-width: 600px) {

    .hero {
      padding: 70px 25px;
    }

    .hero h1 {
      font-size: 3.5rem;
    }

    .section-heading {
      grid-template-columns: 35px 1fr;
    }

    .section-heading h2 {
      font-size: 2.2rem;
    }

  }

</style>