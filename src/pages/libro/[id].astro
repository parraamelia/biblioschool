---
import Layout from "../../layouts/Layout.astro";
import { libros } from "../../data/libros.js";

const base = "/biblioschool/";

export function getStaticPaths() {
  return libros.map((libro) => ({
    params: {
      id: String(libro.id)
    },
    props: {
      libro
    }
  }));
}

const { libro } = Astro.props;
---

<Layout
  titulo={`${libro.titulo} | BiblioSchool`}
  descripcion={`Información, resumen y reseñas de ${libro.titulo}.`}
>
  <main class="detalle">

    <a href={`${base}catalogo/`} class="volver">
      ← Volver al catálogo
    </a>

    <section class="libro-principal">

      <div class="portada">
        <img
          src={libro.portada}
          alt={`Portada de ${libro.titulo}`}
        />
      </div>

      <div class="informacion-principal">

        <span class="categoria">
          {libro.categoria}
        </span>

        <h1>{libro.titulo}</h1>

        <h2>{libro.autor}</h2>

        <div class="datos">
          <div>
            <strong>Año</strong>
            <span>{libro.anio}</span>
          </div>

          <div>
            <strong>Páginas</strong>
            <span>{libro.paginas}</span>
          </div>

          <div>
            <strong>ISBN</strong>
            <span>{libro.isbn}</span>
          </div>
        </div>

      </div>

    </section>

    <section class="contenido-libro">

      <article class="seccion-info">
        <span class="numero">01</span>
        <h2>Resumen del libro</h2>

        <p>
          {libro.resumen}
        </p>
      </article>

      <article class="seccion-info">
        <span class="numero">02</span>
        <h2>Sobre esta obra</h2>

        <p>
          {libro.sobre}
        </p>
      </article>

    </section>

    <section class="reseñas">

      <div class="encabezado-reseñas">
        <div>
          <span class="numero">03</span>
          <h2>Reseñas de lectores</h2>
          <p>
            Conoce lo que otros lectores piensan de este libro.
          </p>
        </div>

        <div class="promedio">
          <strong id="promedio">0.0</strong>
          <div id="estrellas-promedio">☆☆☆☆☆</div>
          <span id="cantidad-reseñas">0 reseñas</span>
        </div>
      </div>

      <div id="lista-reseñas" class="lista-reseñas">
        <p class="cargando">
          Cargando reseñas...
        </p>
      </div>

      <div class="formulario-reseña">

        <h3>¿Ya leíste este libro?</h3>

        <p class="texto-formulario">
          Comparte tu opinión con otros estudiantes.
        </p>

        <div id="mensaje-reseña" class="mensaje"></div>

        <label for="calificacion">
          Tu calificación
        </label>

        <select id="calificacion">
          <option value="5">★★★★★ — Excelente</option>
          <option value="4">★★★★☆ — Muy bueno</option>
          <option value="3">★★★☆☆ — Bueno</option>
          <option value="2">★★☆☆☆ — Regular</option>
          <option value="1">★☆☆☆☆ — No me gustó</option>
        </select>

        <label for="comentario">
          Tu reseña
        </label>

        <textarea
          id="comentario"
          rows="6"
          placeholder="Escribe qué te pareció el libro, qué fue lo que más te gustó o qué aprendiste de él..."
        ></textarea>

        <button id="publicar-reseña">
          Publicar reseña
        </button>

      </div>

    </section>

    <div class="final">
      <a href={`${base}catalogo/`} class="boton-explorar">
        Explorar más libros
      </a>
    </div>

  </main>
</Layout>

<script>
  import { supabase } from "../../lib/supabase.js";

  const libroId = Number(
    window.location.pathname
      .split("/")
      .filter(Boolean)
      .pop()
  );

  const listaResenas =
    document.querySelector("#lista-reseñas");

  const promedio =
    document.querySelector("#promedio");

  const estrellasPromedio =
    document.querySelector("#estrellas-promedio");

  const cantidadResenas =
    document.querySelector("#cantidad-reseñas");

  const calificacion =
    document.querySelector("#calificacion");

  const comentario =
    document.querySelector("#comentario");

  const publicar =
    document.querySelector("#publicar-reseña");

  const mensaje =
    document.querySelector("#mensaje-reseña");

  function mostrarEstrellas(numero) {
    const cantidad = Math.round(Number(numero));

    return "★".repeat(cantidad) +
      "☆".repeat(5 - cantidad);
  }

  function escaparTexto(texto) {
    const div = document.createElement("div");
    div.textContent = texto;
    return div.innerHTML;
  }

  async function cargarResenas() {
    const { data, error } = await supabase
      .from("reseñas_libros")
      .select("*")
      .eq("libro_id", libroId)
      .order("creado_en", {
        ascending: false
      });

    if (error) {
      listaResenas.innerHTML = `
        <p class="sin-resenas">
          No se pudieron cargar las reseñas.
        </p>
      `;
      return;
    }

    if (!data || data.length === 0) {
      promedio.textContent = "0.0";
      estrellasPromedio.textContent = "☆☆☆☆☆";
      cantidadResenas.textContent = "Todavía no hay reseñas";

      listaResenas.innerHTML = `
        <div class="sin-resenas">
          <div class="icono-reseña">✦</div>
          <h3>Aún no hay reseñas</h3>
          <p>
            Sé la primera persona en compartir su opinión
            sobre este libro.
          </p>
        </div>
      `;

      return;
    }

    const total = data.reduce(
      (suma, resena) =>
        suma + Number(resena.calificacion),
      0
    );

    const promedioNumero = total / data.length;

    promedio.textContent =
      promedioNumero.toFixed(1);

    estrellasPromedio.textContent =
      mostrarEstrellas(promedioNumero);

    cantidadResenas.textContent =
      data.length === 1
        ? "1 reseña"
        : `${data.length} reseñas`;

    listaResenas.innerHTML = data
      .map(
        (resena) => `
          <article class="resena">

            <div class="resena-superior">

              <div>
                <strong>
                  ${escaparTexto(resena.nombre_usuario)}
                </strong>

                <div class="estrellas">
                  ${mostrarEstrellas(resena.calificacion)}
                </div>
              </div>

              <span class="fecha">
                ${new Date(
                  resena.creado_en
                ).toLocaleDateString("es-EC")}
              </span>

            </div>

            <p>
              ${escaparTexto(resena.comentario)}
            </p>

          </article>
        `
      )
      .join("");
  }

  async function comprobarUsuario() {
    const { data } =
      await supabase.auth.getSession();

    if (!data.session) {
      mensaje.textContent =
        "Debes iniciar sesión para publicar una reseña.";

      publicar.disabled = true;

      return null;
    }

    return data.session.user;
  }

  publicar?.addEventListener(
    "click",
    async () => {

      mensaje.textContent = "";

      const usuario =
        await comprobarUsuario();

      if (!usuario) {
        return;
      }

      const texto =
        comentario.value.trim();

      if (!texto) {
        mensaje.textContent =
          "Escribe una reseña antes de publicarla.";
        return;
      }

      if (texto.length < 10) {
        mensaje.textContent =
          "La reseña debe tener al menos 10 caracteres.";
        return;
      }

      publicar.disabled = true;
      publicar.textContent = "Publicando...";

      const datosUsuario =
        usuario.user_metadata || {};

      const nombre =
        datosUsuario.nombre_usuario ||
        datosUsuario.nombre_completo ||
        usuario.email?.split("@")[0] ||
        "Usuario";

      const { error } = await supabase
        .from("reseñas_libros")
        .insert({
          libro_id: libroId,
          usuario_id: usuario.id,
          nombre_usuario: nombre,
          calificacion: Number(
            calificacion.value
          ),
          comentario: texto
        });

      if (error) {
        console.error(error);

        mensaje.textContent =
          "No se pudo publicar la reseña.";

        publicar.disabled = false;
        publicar.textContent =
          "Publicar reseña";

        return;
      }

      comentario.value = "";

      calificacion.value = "5";

      mensaje.textContent =
        "¡Tu reseña fue publicada correctamente!";

      publicar.disabled = false;
      publicar.textContent =
        "Publicar reseña";

      await cargarResenas();
    }
  );

  comprobarUsuario();
  cargarResenas();
</script>

<style>
  .detalle {
    max-width: 1100px;
    margin: 0 auto;
    padding: 55px 24px 100px;
  }

  .volver {
    display: inline-block;
    color: #80633f;
    text-decoration: none;
    font-weight: 700;
    margin-bottom: 40px;
  }

  .libro-principal {
    display: grid;
    grid-template-columns: 350px 1fr;
    gap: 65px;
    align-items: center;
  }

  .portada {
    height: 510px;
    border-radius: 20px;
    overflow: hidden;
    background: #eee7df;
    box-shadow: 0 22px 50px rgba(40, 30, 20, 0.15);
  }

  .portada img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .categoria {
    color: #9a7951;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .informacion-principal h1 {
    color: #29241f;
    font-size: clamp(2.7rem, 6vw, 5rem);
    line-height: 1;
    margin: 15px 0;
    letter-spacing: -2px;
  }

  .informacion-principal h2 {
    color: #70675f;
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 35px;
  }

  .datos {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .datos div {
    background: #f2ece4;
    border-radius: 12px;
    padding: 15px;
    min-width: 125px;
  }

  .datos strong {
    display: block;
    color: #302b26;
    font-size: 0.75rem;
    margin-bottom: 5px;
  }

  .datos span {
    color: #756b62;
    font-size: 0.83rem;
  }

  .contenido-libro {
    margin-top: 90px;
    display: grid;
    gap: 55px;
  }

  .seccion-info {
    max-width: 900px;
  }

  .numero {
    color: #a88b67;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 2px;
  }

  .seccion-info h2 {
    color: #29241f;
    font-size: 2.3rem;
    margin: 8px 0 18px;
  }

  .seccion-info p {
    color: #665e56;
    line-height: 1.9;
    font-size: 1.05rem;
    margin: 0;
  }

  .reseñas {
    margin-top: 90px;
    padding-top: 70px;
    border-top: 1px solid #e5ddd3;
  }

  .encabezado-reseñas {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    margin-bottom: 35px;
  }

  .encabezado-reseñas h2 {
    color: #29241f;
    font-size: 2.3rem;
    margin: 8px 0;
  }

  .encabezado-reseñas p {
    color: #756b62;
  }

  .promedio {
    min-width: 160px;
    text-align: center;
    background: #f2ece4;
    border-radius: 18px;
    padding: 20px;
  }

  .promedio strong {
    display: block;
    color: #302b26;
    font-size: 2.3rem;
  }

  .promedio div {
    color: #9a7951;
    font-size: 1.2rem;
    letter-spacing: 2px;
    margin: 4px 0;
  }

  .promedio span {
    color: #776e66;
    font-size: 0.8rem;
  }

  .lista-reseñas {
    display: grid;
    gap: 16px;
  }

  .resena {
    background: #fffdf9;
    border: 1px solid #e3dbd1;
    border-radius: 16px;
    padding: 22px;
  }

  .resena-superior {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 12px;
  }

  .resena-superior strong {
    color: #302b26;
  }

  .estrellas {
    color: #9a7951;
    margin-top: 5px;
    letter-spacing: 2px;
  }

  .fecha {
    color: #999087;
    font-size: 0.75rem;
  }

  .resena p {
    color: #655d55;
    line-height: 1.7;
    margin: 0;
  }

  .sin-resenas {
    text-align: center;
    padding: 45px 20px;
    background: #f7f3ed;
    border-radius: 18px;
  }

  .icono-reseña {
    font-size: 2rem;
    color: #a88b67;
  }

  .sin-resenas h3 {
    color: #302b26;
    margin-bottom: 5px;
  }

  .sin-resenas p {
    color: #777;
    margin: 0;
  }

  .cargando {
    color: #777;
  }

  .formulario-reseña {
    margin-top: 40px;
    background: #302b26;
    border-radius: 22px;
    padding: 35px;
    color: white;
  }

  .formulario-reseña h3 {
    margin: 0 0 8px;
    font-size: 1.5rem;
  }

  .texto-formulario {
    color: #cfc7bf;
    margin-top: 0;
    margin-bottom: 25px;
  }

  .formulario-reseña label {
    display: block;
    color: #e9e2da;
    font-size: 0.85rem;
    font-weight: 700;
    margin: 18px 0 8px;
  }

  .formulario-reseña select,
  .formulario-reseña textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #655b52;
    border-radius: 10px;
    background: #fffdf9;
    color: #302b26;
    padding: 12px;
    font-family: inherit;
    font-size: 0.9rem;
  }

  .formulario-reseña textarea {
    resize: vertical;
  }

  .formulario-reseña button {
    margin-top: 18px;
    border: 0;
    background: #d4b991;
    color: #302b26;
    padding: 13px 22px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 800;
  }

  .formulario-reseña button:hover {
    background: #ead6b7;
  }

  .formulario-reseña button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .mensaje {
    color: #d9c39e;
    font-size: 0.9rem;
    margin-top: 10px;
  }

  .final {
    text-align: center;
    margin-top: 65px;
  }

  .boton-explorar {
    display: inline-block;
    background: #302b26;
    color: white;
    text-decoration: none;
    padding: 14px 25px;
    border-radius: 10px;
    font-weight: 800;
  }

  .boton-explorar:hover {
    background: #574b40;
  }

  @media (max-width: 800px) {
    .libro-principal {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .portada {
      max-width: 350px;
      width: 100%;
      margin: 0 auto;
    }

    .encabezado-reseñas {
      flex-direction: column;
      align-items: flex-start;
    }

    .promedio {
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>