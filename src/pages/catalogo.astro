
---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const libros = [
  { id: 1, titulo: "Cien años de soledad", autor: "Gabriel García Márquez", categoria: "Literatura", anio: 1967 },
  { id: 2, titulo: "Don Quijote de la Mancha", autor: "Miguel de Cervantes", categoria: "Clásicos", anio: 1605 },
  { id: 3, titulo: "La Odisea", autor: "Homero", categoria: "Literatura clásica", anio: 700 },
  { id: 4, titulo: "El principito", autor: "Antoine de Saint-Exupéry", categoria: "Literatura juvenil", anio: 1943 },
  { id: 5, titulo: "Don Juan Tenorio", autor: "José Zorrilla", categoria: "Teatro", anio: 1844 },
  { id: 6, titulo: "La casa de los espíritus", autor: "Isabel Allende", categoria: "Literatura", anio: 1982 }
];
---

<Layout titulo="Catálogo | BiblioSchool">
  <main class="catalogo">
    <section class="encabezado">
      <p class="sobretitulo">NUESTRA COLECCIÓN</p>
      <h1>Un mundo de historias <span>por descubrir.</span></h1>
      <p class="descripcion">
        Explora nuestra selección de libros, descubre nuevos autores
        y encuentra tu próxima lectura.
      </p>
    </section>

    <section class="coleccion">
      <div class="coleccion-cabecera">
        <div>
          <p class="etiqueta">BIBLIOTECA DIGITAL</p>
          <h2>Todos los libros</h2>
        </div>
        <p class="cantidad">{libros.length} títulos disponibles</p>
      </div>

      <div class="libros">
        {libros.map((libro, indice) => (
          <article class="libro">
            <a
              href={`${base}libro/${libro.id}/`}
              class="portada-libro"
              aria-label={`Ver detalles de ${libro.titulo}`}
            >
              <span class="numero">{String(indice + 1).padStart(2, "0")}</span>
              <span class="libro-icono" aria-hidden="true">▤</span>
              <span class="ver-libro">Ver libro ↗</span>
            </a>

            <div class="informacion">
              <p class="categoria">{libro.categoria}</p>
              <h3>
                <a href={`${base}libro/${libro.id}/`}>{libro.titulo}</a>
              </h3>
              <p class="autor">{libro.autor}</p>
              <p class="anio">Publicado en {libro.anio}</p>
              <a href={`${base}libro/${libro.id}/`} class="boton">
                Consultar libro <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <footer class="pie">
      <a href={base} class="marca">BiblioSchool</a>
      <p>Una biblioteca para nuestra comunidad educativa.</p>
      <a href={base}>Volver al inicio ↑</a>
    </footer>
  </main>
</Layout>

<style>
  .catalogo {
    --verde: #293e33;
    --verde-suave: #657568;
    --fondo: #f6f3ec;
    --texto: #30342f;
    --linea: #dcd8cd;
    min-height: 100vh;
    background: var(--fondo);
    color: var(--texto);
  }

  .encabezado {
    max-width: 1200px;
    margin: 0 auto;
    padding: 75px 8% 65px;
    border-bottom: 1px solid var(--linea);
  }

  .sobretitulo,
  .etiqueta {
    color: var(--verde-suave);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .encabezado h1 {
    max-width: 750px;
    margin: 22px 0;
    color: var(--verde);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(40px, 5vw, 65px);
    font-weight: 400;
    letter-spacing: -1.8px;
    line-height: 1.13;
  }

  .encabezado h1 span {
    display: block;
    font-style: italic;
  }

  .descripcion {
    max-width: 520px;
    color: #65665f;
    font-size: 15px;
    line-height: 1.9;
  }

  .coleccion {
    max-width: 1200px;
    margin: 0 auto;
    padding: 50px 8% 80px;
  }

  .coleccion-cabecera {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
  }

  .coleccion-cabecera h2 {
    margin-top: 10px;
    color: var(--verde);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    font-weight: 400;
  }

  .cantidad {
    color: #72736b;
    font-size: 12px;
  }

  .libros {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 38px 25px;
  }

  .libro {
    min-width: 0;
  }

  .portada-libro {
    position: relative;
    display: flex;
    min-height: 260px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #e8e4d9;
    color: var(--verde);
    transition: background 0.2s;
  }

  .libro:nth-child(2n) .portada-libro {
    background: #dedfd4;
  }

  .libro:nth-child(3n) .portada-libro {
    background: #e9ded2;
  }

  .portada-libro:hover {
    background: #d5d9cd;
  }

  .numero {
    position: absolute;
    top: 17px;
    left: 17px;
    font-size: 11px;
    letter-spacing: 1px;
  }

  .libro-icono {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 95px;
    font-weight: 400;
    opacity: 0.65;
  }

  .ver-libro {
    position: absolute;
    right: 15px;
    bottom: 15px;
    font-size: 12px;
  }

  .informacion {
    padding: 20px 0 0;
  }

  .categoria {
    color: var(--verde-suave);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.3px;
    text-transform: uppercase;
  }

  .informacion h3 {
    margin: 10px 0 7px;
    color: var(--verde);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 23px;
    font-weight: 400;
    line-height: 1.3;
  }

  .autor {
    color: #65665f;
    font-size: 13px;
    line-height: 1.7;
  }

  .anio {
    margin-top: 8px;
    color: #88877e;
    font-size: 11px;
  }

  .boton {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
    padding-bottom: 6px;
    border-bottom: 1px solid #a9ad9f;
    color: var(--verde);
    font-size: 12px;
    transition: border-color 0.2s;
  }

  .boton:hover {
    border-color: var(--verde);
  }

  .pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    padding: 28px 8%;
    border-top: 1px solid var(--linea);
    color: #66685f;
    font-size: 12px;
  }

  .marca {
    color: var(--verde);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 21px;
  }

  .pie > a:last-child {
    color: var(--verde);
  }

  @media (max-width: 850px) {
    .encabezado {
      padding: 60px 7% 45px;
    }

    .coleccion {
      padding: 40px 7% 60px;
    }

    .libros {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 20px;
    }

    .portada-libro {
      min-height: 230px;
    }

    .pie {
      padding: 25px 7%;
    }
  }

  @media (max-width: 520px) {
    .encabezado h1 {
      font-size: 42px;
    }

    .coleccion-cabecera {
      align-items: flex-start;
      flex-direction: column;
    }

    .libros {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .portada-libro {
      min-height: 280px;
    }

    .pie {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
