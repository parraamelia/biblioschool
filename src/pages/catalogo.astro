---
import Layout from "../layouts/Layout.astro";
import { libros } from "../data/libros.js";

const base = "/biblioschool/";

const categorias = [
  "Todos",
  "Literatura",
  "Clásicos",
  "Literatura clásica",
  "Literatura juvenil",
  "Teatro",
  "Teatro clásico",
  "Literatura gótica",
  "Aventura",
  "Relatos",
  "Literatura latinoamericana",
  "Ciencia ficción"
];
---

<Layout
  titulo="Catálogo | BiblioSchool"
  descripcion="Explora todos los libros disponibles en BiblioSchool."
>
  <main class="catalogo">
    <section class="encabezado">
      <p class="etiqueta">BIBLIOSCHOOL</p>
      <h1>Catálogo de libros</h1>
      <p class="descripcion">
        Explora nuestra colección y descubre nuevas lecturas.
      </p>
    </section>

    <section class="filtros">
      {categorias.map((categoria) => (
        <button
          class:list={{ activo: categoria === "Todos" }}
          class="filtro"
          data-categoria={categoria}
        >
          {categoria}
        </button>
      ))}
    </section>

    <section class="libros-grid" id="libros-grid">
      {libros.map((libro) => (
        <article class="libro-card" data-categoria={libro.categoria}>
          <div class="portada">
            <img
              src={libro.portada}
              alt={`Portada de ${libro.titulo}`}
              loading="lazy"
            />
          </div>

          <div class="informacion">
            <span class="categoria">{libro.categoria}</span>

            <h2>{libro.titulo}</h2>

            <p class="autor">{libro.autor}</p>

            <p class="anio">{libro.anio}</p>

            <a href={`${base}libro/${libro.id}/`} class="boton">
              Consultar libro
            </a>
          </div>
        </article>
      ))}
    </section>

    <p id="sin-resultados" class="sin-resultados">
      No hay libros en esta categoría.
    </p>
  </main>
</Layout>

<script>
  const botones = document.querySelectorAll(".filtro");
  const libros = document.querySelectorAll(".libro-card");
  const sinResultados = document.querySelector("#sin-resultados");

  botones.forEach((boton) => {
    boton.addEventListener("click", () => {
      const categoria = boton.getAttribute("data-categoria");

      botones.forEach((b) => b.classList.remove("activo"));
      boton.classList.add("activo");

      let encontrados = 0;

      libros.forEach((libro) => {
        const categoriaLibro = libro.getAttribute("data-categoria");

        if (
          categoria === "Todos" ||
          categoriaLibro === categoria
        ) {
          libro.style.display = "flex";
          encontrados++;
        } else {
          libro.style.display = "none";
        }
      });

      sinResultados.style.display =
        encontrados === 0 ? "block" : "none";
    });
  });
</script>

<style>
  .catalogo {
    max-width: 1200px;
    margin: 0 auto;
    padding: 70px 24px 90px;
  }

  .encabezado {
    text-align: center;
    margin-bottom: 40px;
  }

  .etiqueta {
    color: #8a6f4d;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 3px;
    margin-bottom: 12px;
  }

  .encabezado h1 {
    margin: 0;
    color: #29241f;
    font-size: clamp(2.2rem, 5vw, 4rem);
  }

  .descripcion {
    color: #71675e;
    font-size: 1.05rem;
    margin-top: 15px;
  }

  .filtros {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 45px;
  }

  .filtro {
    border: 1px solid #d9cec0;
    background: #fffdf9;
    color: #5f554c;
    padding: 10px 17px;
    border-radius: 30px;
    cursor: pointer;
    font-size: 0.9rem;
    transition: 0.2s;
  }

  .filtro:hover,
  .filtro.activo {
    background: #302b26;
    color: white;
    border-color: #302b26;
  }

  .libros-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .libro-card {
    display: flex;
    flex-direction: column;
    background: #fffdf9;
    border: 1px solid #e6ddd2;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(50, 40, 30, 0.06);
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .libro-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(50, 40, 30, 0.12);
  }

  .portada {
    height: 300px;
    background: #eee7df;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .portada img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .informacion {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .categoria {
    color: #9a7951;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .informacion h2 {
    color: #29241f;
    font-size: 1.1rem;
    margin: 9px 0 6px;
    line-height: 1.3;
  }

  .autor {
    color: #665d55;
    margin: 0;
    font-size: 0.9rem;
  }

  .anio {
    color: #9a9189;
    font-size: 0.8rem;
    margin: 7px 0 18px;
  }

  .boton {
    margin-top: auto;
    text-align: center;
    text-decoration: none;
    background: #302b26;
    color: white;
    padding: 11px 15px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .boton:hover {
    background: #574b40;
  }

  .sin-resultados {
    display: none;
    text-align: center;
    color: #777;
    padding: 50px;
  }

  @media (max-width: 1000px) {
    .libros-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 700px) {
    .libros-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .portada {
      height: 260px;
    }
  }

  @media (max-width: 480px) {
    .libros-grid {
      grid-template-columns: 1fr;
    }
  }
</style>